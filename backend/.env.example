# ==============================================================================
# ReCall AI Backend Environment Variables Template (Zero Secrets Committed)
# In production on Render/Railway/Fly.io, configure these as Environment Variables.
# ==============================================================================

# 1. Cloud Database: Neon Serverless PostgreSQL
NEON_DB_URL=jdbc:postgresql://ep-small-frost-bdsxw5br-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_DB_USER=neondb_owner
NEON_DB_PASS=your_neon_password_here

# 2. Object Storage: Backblaze B2 (S3-Compatible 10GB Free Tier)
STORAGE_TYPE=s3
STORAGE_S3_ENABLED=true
STORAGE_S3_BUCKET=recall4224
STORAGE_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
STORAGE_S3_REGION=us-east-005
STORAGE_S3_ACCESS_KEY=your_b2_access_key_here
STORAGE_S3_SECRET_KEY=your_b2_secret_key_here

# 3. AI Services (Free Dual-Engine)
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# 4. GitHub Auto-Commit GitOps Engine (Zero-DB Vault)
GITHUB_TOKEN=your_github_token_with_contents_write
GITHUB_REPO=sunilkumar4545/ReCall
GITHUB_BRANCH=main

# 5. Security & CORS (Supports localhost + wildcards for Vercel, Netlify, Render)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://*.vercel.app,https://*.netlify.app,https://*.onrender.com,https://*.railway.app
